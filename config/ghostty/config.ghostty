# appearance
background = #1e1e1e
foreground = #e3e5e5
window-padding-x = 5
window-padding-y = 8

# font
font-family = FiraCode Nerd Font
font-size = 11

# cursor
cursor-style = bar
cursor-style-blink = true
gtk-titlebar = false

# misc
scrollback-limit = 10000
copy-on-select = true

command = zellij
