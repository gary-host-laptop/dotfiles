# source global definitions
if [ -f /etc/bashrc ]; then
    . /etc/bashrc
fi

# source dotfiles bash configs
DOTFILES="{{ .chezmoi.sourceDir }}"
for file in "$DOTFILES"/dot_bash/*.bash; do
    # machine-specific files are sourced once below, skip them here
    case "${file##*/}" in
        fedora-specific.bash|nixos-specific.bash) continue ;;
    esac
    [ -f "$file" ] && . "$file"
done
unset file

{{- if eq (.machine | default "fedora") "fedora" }}
source "$DOTFILES/dot_bash/fedora-specific.bash"
{{- else if eq (.machine | default "fedora") "nixos" }}
source "$DOTFILES/dot_bash/nixos-specific.bash"
{{- end }}
