#!/bin/bash

# =============================================================================
# package installation — runs once via chezmoi init
# fedora-specific: dnf, copr, flatpak, cargo
# =============================================================================

{{- if eq .machine "fedora" }}

info()    { echo "  [ .. ] $1"; }
success() { echo "  [ ok ] $1"; }
warn()    { echo "  [warn] $1"; }

# ── copr repos ───────────────────────────────────────────────────────────────
info "enabling copr repos..."
sudo dnf copr enable -y atim/starship
sudo dnf copr enable -y dejan/lazygit
sudo dnf copr enable -y scottames/ghostty
success "copr repos enabled"

# ── dnf ──────────────────────────────────────────────────────────────────────
info "installing dnf packages..."

DNF_PACKAGES=(
    calibre
    flameshot
    firefox
    vlc
    kdenlive
    bat
    btop
    helix
    eza
    glow
    inotify-tools
    mpd
    nushell
)

# glow ships from the charm yum repo
if ! rpm -q glow &>/dev/null; then
    info "enabling charm repo for glow..."
    cat <<'EOF' | sudo tee /etc/yum.repos.d/charm.repo >/dev/null
[charm]
name=Charm
baseurl=https://repo.charm.sh/yum/
enabled=1
gpgcheck=1
gpgkey=https://repo.charm.sh/yum/gpg.key
EOF
    sudo dnf install -y glow || warn "glow install failed"
else
    info "glow already installed ($(rpm -q glow))"
fi

COPR_PACKAGES=(
    starship
    lazygit
    ghostty
)

sudo dnf install -y "${DNF_PACKAGES[@]}" "${COPR_PACKAGES[@]}"
success "dnf packages installed"

# ── flatpak ──────────────────────────────────────────────────────────────────
info "installing flatpak packages..."

flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo

FLATPAK_PACKAGES=(
    net.ankiweb.Anki
    org.amule.aMule
    com.rafaelmardojai.Blanket
    org.chromium.Chromium
    org.gimp.GIMP
    org.inkscape.Inkscape
    io.github.htkhiem.Euphonica
    org.localsend.localsend_app
    org.torproject.torbrowser-launcher
    im.riot.Riot
    org.mozilla.Thunderbird
    org.libretro.RetroArch
    org.tenacityaudio.Tenacity
    org.musicbrainz.Picard
    org.keepassxc.KeePassXC
    org.qbittorrent.qBittorrent
    md.obsidian.Obsidian
    com.github.jeromerobert.pdfarranger
    com.github.tchx84.Flatseal
    io.github.shonubot.Spruce
    com.stremio.Stremio
    org.nicotine_plus.Nicotine
)

flatpak install -y flathub "${FLATPAK_PACKAGES[@]}"
success "flatpak packages installed"

# ── install scripts ─────────────────────────────────────────────────────────
info "installing via install scripts..."

bash -c "$(curl -sLo- https://superfile.dev/install.sh)" \
    || warn "superfile install failed — retry from https://superfile.dev/getting-started/installation/"

# ── rust toolchain ──────────────────────────────────────────────────────────
info "installing rust toolchain (rustup, non-distro cargo)…"

if ! command -v rustup &>/dev/null; then
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
        | sh -s -- -y --default-toolchain stable \
        || warn "rustup install failed — retry from https://rustup.rs"
else
    info "rustup already installed"
fi
export PATH="$HOME/.cargo/bin:$PATH"

# ── cargo binaries ──────────────────────────────────────────────────────────
info "installing cargo binaries..."

cargo install cargo-binstall || warn "cargo-binstall install failed"
cargo binstall -y zellij || warn "zellij install failed — retry with 'cargo binstall zellij'"

cargo install --locked topgrade zoxide \
    || warn "topgrade/zoxide install failed — retry with 'cargo install topgrade zoxide'"

cargo install --locked croft-software \
    || warn "croft install failed — retry with 'cargo install croft-software'"

if ! command -v yazi &>/dev/null || ! yazi --version | grep -qP '26\.9\.'; then
    info "installing yazi from GitHub release (latest)…"
    tmp="$(mktemp -d)"
    curl -L -o "$tmp/yazi.zip" \
        "https://github.com/sxyazi/yazi/releases/download/v26.9.1/yazi-x86_64-unknown-linux-gnu.zip"
    unzip -o "$tmp/yazi.zip" -d "$tmp" >/dev/null
    cp "$tmp"/yazi-x86_64-unknown-linux-gnu/{yazi,ya} ~/.cargo/bin/ && chmod +x ~/.cargo/bin/{yazi,ya}
    rm -rf "$tmp"
    success "yazi $(yazi --version | head -1) installed"
else
    info "yazi already up to date"
fi

# ── bleachbit ───────────────────────────────────────────────────────────────
if ! rpm -q bleachbit &>/dev/null; then
    info "installing bleachbit upstream rpm…"
    BB_VER="6.0.3"
    tmp="$(mktemp -d)"
    curl -L -o "$tmp/bleachbit.rpm" \
        "https://github.com/bleachbit/bleachbit/releases/download/v${BB_VER}/bleachbit-${BB_VER}-1.1.fc44.noarch.rpm" \
        || warn "bleachbit download failed"
    sudo dnf install -y "$tmp/bleachbit.rpm" \
        || warn "bleachbit install failed — manual: https://www.bleachbit.org/download/linux"
    rm -rf "$tmp"
else
    info "bleachbit already installed ($(rpm -q bleachbit))"
fi

# ── rpm (direct) ────────────────────────────────────────────────────────────
info "installing rpm packages..."

sudo dnf install -y \
    https://repo.steampowered.com/steam/archive/stable/steam-repo-1-0.x86_64.rpm \
    || warn "steam rpm failed — install manually from steampowered.com"
sudo dnf install -y steam || warn "steam install failed"

warn "veracrypt: download rpm from https://www.veracrypt.fr/en/Downloads.html and install manually"
warn "zed: install via 'curl -f https://zed.dev/install.sh | sh' or flatpak from flathub (dev.zed.Zed)"

success "rpm section done"

echo ""
success "packages done. check warnings above for any manual steps needed."
echo ""

{{- else if eq .machine "nixos" }}
# nixos packages are managed by home.nix and configuration.nix
# run: nix flake update && sudo nixos-rebuild switch --flake .
echo "nixos: packages managed by nix — skipping dnf/flatpak setup"
{{- end }}
