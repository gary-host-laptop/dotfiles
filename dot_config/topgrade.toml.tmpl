[misc]
{{- if eq .machine "fedora" }}
[linux]
# dnf: pass --refresh to pick up new metadata
dnf_arguments = "--refresh"
{{- else if eq .machine "nixos" }}
[nix]
# topgrade detects nixos and runs nix flake update / nixos-rebuild.
{{- end }}

[flatpak]
# use sudo for updating the system-wide installation
use_sudo = true
