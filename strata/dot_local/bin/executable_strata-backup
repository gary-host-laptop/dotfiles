#!/bin/bash

BOLD='\033[1m'
CYAN='\033[38;2;122;162;247m'
MUTED='\033[38;2;59;66;97m'
LAVENDER='\033[38;2;169;177;214m'
GREEN='\033[38;2;0;255;150m'
YELLOW='\033[38;2;255;220;100m'
RESET='\033[0m'

set -euo pipefail

ROOT="${HOME}/strata/10-19_system/14_backups/data"
STORE="${HOME}/strata/10-19_system/14_backups/plakar-store"
PLAKAR="${PLAKAR:-}"
if [ -z "$PLAKAR" ] || [ ! -x "$PLAKAR" ]; then
    for candidate in /usr/bin/plakar /usr/local/bin/plakar; do
        if [ -x "$candidate" ]; then
            PLAKAR="$candidate"
            break
        fi
    done
fi
if [ -z "$PLAKAR" ] || [ ! -x "$PLAKAR" ]; then
    if [ -z "${CREDENTIALS_DIRECTORY:-}" ] && [ -x "${HOME}/.local/bin/plakar" ]; then
        PLAKAR="${HOME}/.local/bin/plakar"
    fi
fi
if [ -z "$PLAKAR" ] || [ ! -x "$PLAKAR" ]; then
    echo "plakar not found" >&2
    exit 1
fi
FF_PROFILE="${HOME}/.mozilla/firefox/ghost-profile"

LOCK_DIR="${HOME}/.cache"
mkdir -p "$LOCK_DIR"
exec 9>"${LOCK_DIR}/strata-backup.lock"
if ! flock -n 9; then
    echo "strata-backup already running"
    exit 0
fi

copied=()
report_fail() {
    echo -e "  ${YELLOW}fail${RESET}  ${MUTED}$1${RESET}  ($2)" >&2
}

copy() {
    local src="$1"
    local dst="$2"
    local name
    name="$(basename "$src")"
    if [ ! -e "$src" ]; then
        echo -e "  ${YELLOW}skip${RESET}  ${MUTED}${name}${RESET}  (missing)"
        return 0
    fi
    if ! mkdir -p "$(dirname "$dst")"; then
        report_fail "$name" "mkdir failed"
        return 1
    fi
    if ! cp -p "$src" "$dst"; then
        report_fail "$name" "copy failed"
        return 1
    fi
    copied+=("$name")
}

copy_dir() {
    local src="$1"
    local dst="$2"
    local name
    name="$(basename "$src")"
    if [ ! -d "$src" ]; then
        echo -e "  ${YELLOW}skip${RESET}  ${MUTED}${name}${RESET}  (missing)"
        return 0
    fi
    if ! mkdir -p "$dst"; then
        report_fail "${name}/" "mkdir failed"
        return 1
    fi
    if ! cp -pR "$src"/. "$dst"/; then
        report_fail "${name}/" "copy failed"
        return 1
    fi
    copied+=("${name}/")
}

copy_sqlite() {
    local src="$1"
    local dst="$2"
    local tmp="${dst}.tmp"
    local snapdir
    local name
    name="$(basename "$src")"
    if [ ! -e "$src" ]; then
        echo -e "  ${YELLOW}skip${RESET}  ${MUTED}${name}${RESET}  (missing)"
        return 0
    fi
    if ! command -v sqlite3 >/dev/null 2>&1; then
        report_fail "$name" "sqlite3 missing"
        return 1
    fi
    if ! snapdir="$(mktemp -d "${TMPDIR:-/tmp}/strata-sqlite.XXXXXX")"; then
        report_fail "$name" "temp dir failed"
        return 1
    fi
    if ! cp -p "$src" "$snapdir/db"; then
        rm -rf "$snapdir"
        report_fail "$name" "copy failed"
        return 1
    fi
    if [ -e "${src}-wal" ] && ! cp -p "${src}-wal" "$snapdir/db-wal"; then
        rm -rf "$snapdir"
        report_fail "$name" "WAL copy failed"
        return 1
    fi
    if ! sqlite3 "$snapdir/db" "PRAGMA integrity_check;" >/dev/null 2>&1; then
        rm -rf "$snapdir"
        report_fail "$name" "integrity check failed"
        return 1
    fi
    if ! mkdir -p "$(dirname "$dst")"; then
        rm -rf "$snapdir"
        report_fail "$name" "mkdir failed"
        return 1
    fi
    rm -f "$tmp"
    if ! sqlite3 "$snapdir/db" ".backup '$tmp'"; then
        rm -rf "$snapdir"
        rm -f "$tmp"
        report_fail "$name" "backup failed"
        return 1
    fi
    rm -rf "$snapdir"
    if ! mv "$tmp" "$dst"; then
        rm -f "$tmp"
        report_fail "$name" "move failed"
        return 1
    fi
    copied+=("$name")
}

echo ""
echo -e "  ${CYAN}${BOLD}── essentials backup ──${RESET}  ${MUTED}→ ${ROOT}${RESET}"

copy "${HOME}/.config/chezmoi/chezmoi.toml"      "${ROOT}/chezmoi/chezmoi.toml"
for f in id_ed25519 id_ed25519.pub known_hosts known_hosts.old; do
    copy "${HOME}/.ssh/${f}"                     "${ROOT}/ssh/${f}"
done
copy_dir "${HOME}/.config/beets"                 "${ROOT}/beets"
if [ -d "$FF_PROFILE" ]; then
    copy_sqlite "${FF_PROFILE}/cookies.sqlite"    "${ROOT}/firefox-profile/cookies.sqlite"
    copy_sqlite "${FF_PROFILE}/places.sqlite"     "${ROOT}/firefox-profile/places.sqlite"
else
    echo -e "  ${YELLOW}skip${RESET}  ${MUTED}firefox profile${RESET}  (missing)"
fi
copy "/etc/fstab"                                 "${ROOT}/fstab/fstab"

echo ""
echo -e "  ${GREEN}${BOLD}${#copied[@]} file(s) backed up${RESET}: ${LAVENDER}${copied[*]}${RESET}"

keyfile_args=()
if [[ -n "${CREDENTIALS_DIRECTORY:-}" ]]; then
    keyfile_args=(-keyfile "${CREDENTIALS_DIRECTORY}/plakar-passphrase")
elif [[ -n "${PLAKAR_KEYFILE:-}" ]]; then
    keyfile_args=(-keyfile "${PLAKAR_KEYFILE}")
fi

echo ""
echo -e "  ${CYAN}${BOLD}── plakar snapshot ──${RESET}  ${MUTED}→ ${STORE}${RESET}"
"$PLAKAR" "${keyfile_args[@]}" at "$STORE" backup -check -tag essentials -name essentials "$ROOT"

echo ""
echo -e "  ${CYAN}${BOLD}── plakar retention ──${RESET}  ${MUTED}7 daily / 4 weekly / 12 monthly${RESET}"
"$PLAKAR" "${keyfile_args[@]}" at "$STORE" prune \
    -tag essentials \
    -days 7 -per-day 1 \
    -weeks 4 -per-week 1 \
    -months 12 -per-month 1 \
    -apply
"$PLAKAR" "${keyfile_args[@]}" at "$STORE" maintenance
echo ""