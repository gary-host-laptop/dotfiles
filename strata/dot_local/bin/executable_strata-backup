#!/bin/bash

BOLD='\033[1m'
CYAN='\033[38;2;122;162;247m'
MUTED='\033[38;2;59;66;97m'
LAVENDER='\033[38;2;169;177;214m'
GREEN='\033[38;2;0;255;150m'
YELLOW='\033[38;2;255;220;100m'
RESET='\033[0m'

set -euo pipefail

ROOT="${HOME}/strata/10-19_system/14_backups/data"
STORE="${HOME}/strata/10-19_system/14_backups/plakar-store"
PLAKAR="${PLAKAR:-}"
if [ -z "$PLAKAR" ] || [ ! -x "$PLAKAR" ]; then
    for candidate in /usr/bin/plakar /usr/local/bin/plakar; do
        if [ -x "$candidate" ]; then
            PLAKAR="$candidate"
            break
        fi
    done
fi
if [ -z "$PLAKAR" ] || [ ! -x "$PLAKAR" ]; then
    if [ -z "${CREDENTIALS_DIRECTORY:-}" ] && [ -x "${HOME}/.local/bin/plakar" ]; then
        PLAKAR="${HOME}/.local/bin/plakar"
    fi
fi
if [ -z "$PLAKAR" ] || [ ! -x "$PLAKAR" ]; then
    echo "plakar not found" >&2
    exit 1
fi
FF_PROFILE="${HOME}/.mozilla/firefox/ghost-profile"

LOCK_DIR="${HOME}/.cache"
mkdir -p "$LOCK_DIR"
exec 9>"${LOCK_DIR}/strata-backup.lock"
if ! flock -n 9; then
    echo "strata-backup already running"
    exit 0
fi

copied=()
copy() {
    local src="$1"
    local dst="$2"
    if [ ! -e "$src" ]; then
        echo -e "  ${YELLOW}skip${RESET}  ${MUTED}$(basename "$src")${RESET}  (missing)"
        return 1
    fi
    mkdir -p "$(dirname "$dst")"
    cp -p "$src" "$dst"
    copied+=("$(basename "$src")")
}

copy_dir() {
    local src="$1"
    local dst="$2"
    if [ ! -d "$src" ]; then
        echo -e "  ${YELLOW}skip${RESET}  ${MUTED}$(basename "$src")${RESET}  (missing)"
        return 1
    fi
    mkdir -p "$dst"
    cp -pR "$src"/. "$dst"/
    copied+=("$(basename "$src")/")
}

copy_sqlite() {
    local src="$1"
    local dst="$2"
    local tmp="${dst}.tmp"
    local snapdir
    if [ ! -e "$src" ]; then
        echo -e "  ${YELLOW}skip${RESET}  ${MUTED}$(basename "$src")${RESET}  (missing)"
        return 1
    fi
    if ! command -v sqlite3 >/dev/null 2>&1; then
        echo -e "  ${YELLOW}skip${RESET}  ${MUTED}$(basename "$src")${RESET}  (sqlite3 missing)"
        return 1
    fi
    snapdir="$(mktemp -d "${TMPDIR:-/tmp}/strata-sqlite.XXXXXX")" || {
        echo -e "  ${YELLOW}skip${RESET}  ${MUTED}$(basename "$src")${RESET}  (temp dir failed)"
        return 1
    }
    if ! cp -p "$src" "$snapdir/db"; then
        rm -rf "$snapdir"
        echo -e "  ${YELLOW}skip${RESET}  ${MUTED}$(basename "$src")${RESET}  (copy failed)"
        return 1
    fi
    if [ -e "${src}-wal" ]; then
        cp -p "${src}-wal" "$snapdir/db-wal" || true
    fi
    if ! sqlite3 "$snapdir/db" "PRAGMA integrity_check;" >/dev/null 2>&1; then
        rm -rf "$snapdir"
        echo -e "  ${YELLOW}skip${RESET}  ${MUTED}$(basename "$src")${RESET}  (integrity check failed)"
        return 1
    fi
    mkdir -p "$(dirname "$dst")"
    rm -f "$tmp"
    if ! sqlite3 "$snapdir/db" ".backup '$tmp'"; then
        rm -rf "$snapdir"
        rm -f "$tmp"
        echo -e "  ${YELLOW}skip${RESET}  ${MUTED}$(basename "$src")${RESET}  (backup failed)"
        return 1
    fi
    rm -rf "$snapdir"
    mv "$tmp" "$dst"
    copied+=("$(basename "$src")")
}

echo ""
echo -e "  ${CYAN}${BOLD}── essentials backup ──${RESET}  ${MUTED}→ ${ROOT}${RESET}"

copy "${HOME}/.config/chezmoi/chezmoi.toml"      "${ROOT}/chezmoi/chezmoi.toml" || true
for f in id_ed25519 id_ed25519.pub known_hosts known_hosts.old; do
    copy "${HOME}/.ssh/${f}"                     "${ROOT}/ssh/${f}" || true
done
copy_dir "${HOME}/.config/beets"                 "${ROOT}/beets" || true
if [ -d "$FF_PROFILE" ]; then
    copy_sqlite "${FF_PROFILE}/cookies.sqlite"    "${ROOT}/firefox-profile/cookies.sqlite" || true
    copy_sqlite "${FF_PROFILE}/places.sqlite"     "${ROOT}/firefox-profile/places.sqlite" || true
else
    echo -e "  ${YELLOW}skip${RESET}  ${MUTED}firefox profile${RESET}  (missing)"
fi
copy "/etc/fstab"                                 "${ROOT}/fstab/fstab" || true

echo ""
echo -e "  ${GREEN}${BOLD}${#copied[@]} file(s) backed up${RESET}: ${LAVENDER}${copied[*]}${RESET}"

keyfile_args=()
if [[ -n "${CREDENTIALS_DIRECTORY:-}" ]]; then
    keyfile_args=(-keyfile "${CREDENTIALS_DIRECTORY}/plakar-passphrase")
elif [[ -n "${PLAKAR_KEYFILE:-}" ]]; then
    keyfile_args=(-keyfile "${PLAKAR_KEYFILE}")
fi

echo ""
echo -e "  ${CYAN}${BOLD}── plakar snapshot ──${RESET}  ${MUTED}→ ${STORE}${RESET}"
"$PLAKAR" "${keyfile_args[@]}" at "$STORE" backup -check -tag essentials -name essentials "$ROOT"

echo ""
echo -e "  ${CYAN}${BOLD}── plakar retention ──${RESET}  ${MUTED}7 daily / 4 weekly / 12 monthly${RESET}"
"$PLAKAR" "${keyfile_args[@]}" at "$STORE" prune \
    -tag essentials \
    -days 7 -per-day 1 \
    -weeks 4 -per-week 1 \
    -months 12 -per-month 1 \
    -apply
"$PLAKAR" "${keyfile_args[@]}" at "$STORE" maintenance
echo ""