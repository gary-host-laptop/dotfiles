#!/bin/bash

BOLD='\033[1m'
CYAN='\033[38;2;122;162;247m'
MUTED='\033[38;2;59;66;97m'
GREEN='\033[38;2;0;255;150m'
YELLOW='\033[38;2;255;220;100m'
RED='\033[38;2;255;80;80m'
RESET='\033[0m'

bar() {
    local used=$1
    local total=$2
    local width=20
    local pct=$(( used * 100 / total ))
    local filled=$(( pct * width / 100 ))
    local empty=$(( width - filled ))

    if [ $pct -ge 90 ]; then color=$RED
    elif [ $pct -ge 70 ]; then color=$YELLOW
    else color=$GREEN
    fi

    printf '%b' "$color"
    for ((i=0; i<filled; i++)); do printf '█'; done
    printf '%b' "$MUTED"
    for ((i=0; i<empty; i++)); do printf '░'; done
    printf '%b %b%s%%%b' "$RESET" "$color" "$pct" "$RESET"
}

not_mounted_bar() {
    local width=20
    printf '%b' "$MUTED"
    for ((i=0; i<width; i++)); do printf '█'; done
    printf '%b' "$RESET"
}

disk_info() {
    local mount=$1
    local label=$2
    if ! mountpoint -q "$mount" 2>/dev/null; then
        printf '  %b%-10s%b  ' "$CYAN" "$label" "$RESET"
        not_mounted_bar
        printf ' %bnot mounted%b\n' "$RED" "$RESET"
        return
    fi
    local info
    info=$(df -BG "$mount" 2>/dev/null | tail -1)
    if [ -z "$info" ]; then
        printf '  %b%-10s%b  ' "$CYAN" "$label" "$RESET"
        not_mounted_bar
        printf ' %bnot mounted%b\n' "$RED" "$RESET"
        return
    fi
    local total
    total=$(echo "$info" | awk '{print $2}' | tr -d 'G')
    local used
    used=$(echo "$info" | awk '{print $3}' | tr -d 'G')
    local avail
    avail=$(echo "$info" | awk '{print $4}' | tr -d 'G')

    printf '  %b%-10s%b  ' "$CYAN" "$label" "$RESET"
    bar "$used" "$total"
    printf '  %b%sG / %sG  (%sG free)%b\n' "$MUTED" "$used" "$total" "$avail" "$RESET"
}

echo ""
echo -e "  ${CYAN}${BOLD}── strata storage status ──${RESET}"
echo ""
disk_info "/"                "/        "
disk_info "/mnt/valus"       "valus    "
disk_info "/mnt/phaedra"     "phaedra  "
echo ""
