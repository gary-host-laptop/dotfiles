#!/bin/bash

WALLPAPER_DIR="$HOME/strata/10-19_system/13_system-config/theming/wallpapers"
BOLD='\033[1m'
CYAN='\033[38;2;122;162;247m'
MUTED='\033[38;2;59;66;97m'
RESET='\033[0m'

ask_yn() {
    local prompt="$1"
    local answer
    while true; do
        echo -e "${CYAN}${prompt} [y/n]:${RESET} "
        read -r answer
        case "$answer" in
            y|Y) return 0 ;;
            n|N) return 1 ;;
            *) echo -e "${MUTED}please answer y or n${RESET}" ;;
        esac
    done
}

require_gsettings() {
    if ! command -v gsettings >/dev/null 2>&1; then
        echo "gsettings not found — cannot apply wallpaper settings" >&2
        return 1
    fi
    if ! gsettings get org.gnome.desktop.background picture-uri >/dev/null 2>&1; then
        echo "gsettings cannot read desktop background settings" >&2
        return 1
    fi
}

set_random() {
    local files=()
    while IFS= read -r -d '' f; do
        files+=("$f")
    done < <(find "$WALLPAPER_DIR" -maxdepth 1 -type f \
        \( -iname "*.jpg" -o -iname "*.jpeg" -o -iname "*.png" \
           -o -iname "*.webp" -o -iname "*.gif" \) -print0)

    if [ ${#files[@]} -eq 0 ]; then
        echo "no wallpapers found in $WALLPAPER_DIR" >&2
        return 1
    fi

    require_gsettings || return 1

    local chosen="${files[$RANDOM % ${#files[@]}]}"
    local uri="file://$chosen"

    if ! gsettings set org.gnome.desktop.background picture-uri "$uri"; then
        echo "failed to set picture-uri" >&2
        return 1
    fi
    if ! gsettings set org.gnome.desktop.background picture-uri-dark "$uri"; then
        echo "failed to set picture-uri-dark" >&2
        return 1
    fi
    echo "$chosen"
}

# ── interactive setup ────────────────────────────────────────────────────────
if [ "$1" = "--setup" ]; then
    echo -e "\n${CYAN}${BOLD}wallpaper changer setup${RESET}"
    echo -e "${MUTED}$(find "$WALLPAPER_DIR" -maxdepth 1 -type f \( -iname "*.jpg" -o -iname "*.jpeg" -o -iname "*.png" -o -iname "*.webp" \) | wc -l) wallpapers found${RESET}\n"

    if ! ask_yn "enable wallpaper rotation?"; then
        if ! systemctl --user disable --now wallpaper.timer; then
            echo "failed to disable wallpaper.timer" >&2
            exit 1
        fi
        echo -e "\n${MUTED}wallpaper rotation disabled — run 'wallpaper --setup' to re-enable${RESET}\n"
        exit 0
    fi

    require_gsettings || exit 1

    while true; do
        echo -e "${CYAN}time interval? (hours, default 6):${RESET} "
        read -r interval
        interval=${interval:-6}
        if [[ "$interval" =~ ^[0-9]+$ ]] && [ "$interval" -gt 0 ]; then
            break
        fi
        echo -e "${MUTED}please enter a positive number${RESET}"
    done

    interval_sec=$(( interval * 3600 ))

    # interval is machine-local → keep it out of the versioned unit file
    # a drop-in overrides the repo's 6h default without touching the symlink
    # (removing it reverts to the versioned default)
    timer_dir="$HOME/.config/systemd/user/wallpaper.timer.d"
    if ! mkdir -p "$timer_dir"; then
        echo "failed to create $timer_dir" >&2
        exit 1
    fi
    if ! cat > "$timer_dir/interval.conf" <<EOF
[Timer]
OnUnitActiveSec=${interval_sec}s
EOF
    then
        echo "failed to write $timer_dir/interval.conf" >&2
        exit 1
    fi

    if ! systemctl --user daemon-reload; then
        echo "failed to reload systemd user units" >&2
        exit 1
    fi
    if ! systemctl --user enable --now wallpaper.timer; then
        echo "failed to enable wallpaper.timer" >&2
        exit 1
    fi

    if ask_yn "set a wallpaper right now?"; then
        if ! chosen="$(set_random)"; then
            exit 1
        fi
        echo -e "${CYAN}set:${RESET} $(basename "$chosen")"
    fi

    echo -e "\n${MUTED}rotation enabled — next change in ${interval}h${RESET}\n"
    exit 0
fi

# ── called by timer or directly ──────────────────────────────────────────────
set_random || exit 1
