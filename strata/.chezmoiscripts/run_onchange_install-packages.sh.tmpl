#!/bin/bash

# =============================================================================
# package installation — idempotent, re-runs when this script changes
# fedora-specific: dnf, copr, flatpak, cargo
# =============================================================================

{{- if eq (.machine | default "fedora") "fedora" }}

set -o pipefail

info()    { echo "  [ .. ] $1"; }
success() { echo "  [ ok ] $1"; }
warn()    { echo "  [warn] $1"; }
fail()    { warn "$1"; exit 1; }
optional_failures=0
optional_warn() {
  optional_failures=$((optional_failures + 1))
  warn "$1"
}

require_sudo() {
  sudo -v || {
    warn "sudo credentials unavailable — run 'sudo -v' first, then re-run 'chezmoi apply'"
    return 1
  }
}
require_sudo || exit 1

# ── copr repos ───────────────────────────────────────────────────────────────
info "enabling copr repos..."
sudo dnf copr enable -y atim/starship || fail "failed to enable atim/starship copr"
sudo dnf copr enable -y dejan/lazygit || fail "failed to enable dejan/lazygit copr"
sudo dnf copr enable -y scottames/ghostty || fail "failed to enable scottames/ghostty copr"
success "copr repos enabled"

# ── dnf ──────────────────────────────────────────────────────────────────────
info "installing dnf packages..."

# yank installs as yank-cli (upstream rename) — aliases.bash weds it to wl-copy
DNF_PACKAGES=(
    flameshot
    firefox
    vlc
    yank
    kdenlive
    kitty            # second terminal — kitty graphics protocol testing
    bat
    btop
    helix
    eza
    fastfetch
    glow
    golang
    inotify-tools
    mpd
    nushell
    retroarch
    retroarch-assets
    sqlite
)

# glow ships from the charm yum repo
if ! rpm -q glow &>/dev/null; then
    info "enabling charm repo for glow..."
    cat <<'EOF' | sudo tee /etc/yum.repos.d/charm.repo >/dev/null || fail "failed to write charm repo"
[charm]
name=Charm
baseurl=https://repo.charm.sh/yum/
enabled=1
gpgcheck=1
gpgkey=https://repo.charm.sh/yum/gpg.key
EOF
    sudo dnf install -y glow || fail "glow install failed"
else
    info "glow already installed ($(rpm -q glow))"
fi

COPR_PACKAGES=(
    starship
    lazygit
    ghostty
)

if ! sudo dnf install -y --refresh "${DNF_PACKAGES[@]}" "${COPR_PACKAGES[@]}"; then
    fail "dnf package installation failed"
fi

for pkg in golang sqlite; do
    rpm -q "$pkg" >/dev/null 2>&1 || fail "package missing after dnf install: $pkg"
done

for cmd in go sqlite3; do
    command -v "$cmd" >/dev/null 2>&1 || fail "command missing after dnf install: $cmd"
done

success "dnf packages installed"

# bat >=0.26 only reads custom themes through its binary asset cache
# (~/.cache/bat/themes.bin) — .tmTheme files in dot_config/bat/themes are
# ignored otherwise, and --theme then warns "Unknown theme". metadata.yaml
# pins the bat version, so re-run this after a bat upgrade or bat fails
# with an incompatible-cache error.
info "building bat asset cache (custom themes)..."
bat cache --build || optional_warn "bat cache --build failed — custom themes won't load until re-run"

# ── flatpak ──────────────────────────────────────────────────────────────────
info "installing flatpak packages..."

if ! flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo; then
    optional_warn "flatpak flathub remote add failed"
fi

FLATPAK_PACKAGES=(
    net.ankiweb.Anki
    com.rafaelmardojai.Blanket
    org.chromium.Chromium
    org.gimp.GIMP
    org.inkscape.Inkscape
    io.github.htkhiem.Euphonica
    org.localsend.localsend_app
    org.torproject.torbrowser-launcher
    im.riot.Riot
    org.mozilla.Thunderbird
    org.tenacityaudio.Tenacity
    org.musicbrainz.Picard
    org.keepassxc.KeePassXC
    org.qbittorrent.qBittorrent
    md.obsidian.Obsidian
    com.github.jeromerobert.pdfarranger
    com.github.tchx84.Flatseal
    io.github.shonubot.Spruce
    com.stremio.Stremio
    org.nicotine_plus.Nicotine
)

# install only the missing subset — skip the expensive full re-run
installed=$(flatpak list --app --columns=application 2>/dev/null)
to_install=()
for pkg in "${FLATPAK_PACKAGES[@]}"; do
    grep -qxF -- "$pkg" <<<"$installed" || to_install+=("$pkg")
done

if [ ${#to_install[@]} -eq 0 ]; then
    info "all flatpaks already installed"
    success "flatpak packages installed"
elif flatpak install -y flathub "${to_install[@]}"; then
    success "flatpak packages installed"
else
    optional_warn "flatpak install failed — check ids in the FLATPAK_PACKAGES list"
fi

# ── install scripts ─────────────────────────────────────────────────────────
info "installing via install scripts..."

if ! command -v spf &>/dev/null; then
    if curl -fsSL https://superfile.dev/install.sh | bash; then
        if command -v spf >/dev/null 2>&1; then
            success "superfile installed"
        else
            optional_warn "superfile installer completed but spf is not on PATH"
        fi
    else
        optional_warn "superfile install failed — retry from https://superfile.dev/getting-started/installation/"
    fi
else
    info "superfile already installed"
fi

# ── rust toolchain ──────────────────────────────────────────────────────────
export PATH="$HOME/.cargo/bin:$PATH"
info "installing rust toolchain (rustup, non-distro cargo)…"

if ! command -v rustup &>/dev/null; then
    if curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable; then
        if command -v rustup >/dev/null 2>&1; then
            success "rustup installed"
        else
            optional_warn "rustup installer completed but rustup is not on PATH"
        fi
    else
        optional_warn "rustup install failed — retry from https://rustup.rs"
    fi
else
    info "rustup already installed"
fi

# ── cargo binaries ──────────────────────────────────────────────────────────
info "installing cargo binaries..."

if ! command -v cargo-binstall &>/dev/null; then
    cargo install cargo-binstall || optional_warn "cargo-binstall install failed"
else
    info "cargo-binstall already installed"
fi

if ! command -v zellij &>/dev/null; then
    cargo binstall -y zellij || optional_warn "zellij install failed — retry with 'cargo binstall zellij'"
else
    info "zellij already installed ($(zellij --version 2>/dev/null | head -1))"
fi

if ! command -v topgrade &>/dev/null || ! command -v zoxide &>/dev/null; then
    cargo install --locked topgrade zoxide \
        || optional_warn "topgrade/zoxide install failed — retry with 'cargo install topgrade zoxide'"
else
    info "topgrade/zoxide already installed"
fi

if ! command -v croft &>/dev/null; then
    cargo install --locked croft-software \
        || optional_warn "croft install failed — retry with 'cargo install croft-software'"
else
    info "croft already installed"
fi

if ! command -v rmpc &>/dev/null || ! command -v superseedr &>/dev/null; then
    cargo install --locked rmpc superseedr \
        || optional_warn "rmpc/superseedr install failed — retry with 'cargo install rmpc superseedr'"
else
    info "rmpc/superseedr already installed"
fi

# yazi is pinned to a GitHub release (no dnf/rust package) — bump this manually
YAZI_VER="26.9.1"

if ! command -v yazi &>/dev/null || [ "$(yazi --version | awk '{print $2}')" != "$YAZI_VER" ]; then
    info "installing yazi from GitHub release (v$YAZI_VER)…"
    if ! tmp="$(mktemp -d)"; then
        optional_warn "yazi install failed — temp dir creation failed"
    elif ! mkdir -p "${HOME}/.cargo/bin"; then
        optional_warn "yazi install failed — could not create ~/.cargo/bin"
    else
        if curl -fL -o "$tmp/yazi.zip" \
                "https://github.com/sxyazi/yazi/releases/download/v${YAZI_VER}/yazi-x86_64-unknown-linux-gnu.zip" \
            && unzip -o "$tmp/yazi.zip" -d "$tmp" >/dev/null \
            && cp "$tmp"/yazi-x86_64-unknown-linux-gnu/{yazi,ya} "${HOME}/.cargo/bin/" \
            && chmod +x "${HOME}/.cargo/bin/"{yazi,ya} \
            && [ "$("${HOME}/.cargo/bin/yazi" --version | awk '{print $2}')" = "$YAZI_VER" ]; then
            success "yazi $("${HOME}/.cargo/bin/yazi" --version | head -1) installed"
        else
            optional_warn "yazi install failed — retry from https://github.com/sxyazi/yazi/releases/tag/v${YAZI_VER}"
        fi
        rm -rf "$tmp"
    fi
else
    info "yazi already installed"
fi

# ── zotero ───────────────────────────────────────────────────────
# official tarball (no dnf/copr/flatpak package worth using — the flathub build
# sandboxes the data dir). Pinned like yazi: bump manually.
#
# extracts to ~/.local/opt/Zotero-<ver>, with a stable ~/.local/opt/Zotero
# symlink, so an upgrade leaves the old version in place and rollback is a
# symlink flip. ~/.local/bin/zotero is a launcher, so the desktop entry and PATH
# both survive upgrades. The library itself lives OUTSIDE the dotfiles tree at
# ~/strata/30-39_media/31_text/zotero (set once in the app under
# Preferences -> Advanced -> Data Directory Location) — deliberately not tracked.
ZOTERO_VER="10.0.5"
ZOTERO_URL="https://download.zotero.org/client/release/${ZOTERO_VER}/Zotero-${ZOTERO_VER}_linux-x86_64.tar.xz"
ZOTERO_OPT="${HOME}/.local/opt"
ZOTERO_LIB="${HOME}/strata/30-39_media/31_text/zotero"

if [ ! -x "${ZOTERO_OPT}/Zotero-${ZOTERO_VER}/zotero" ]; then
    info "installing zotero v${ZOTERO_VER} from the official tarball…"
    if ! tmp="$(mktemp -d)"; then
        optional_warn "zotero install failed — temp dir creation failed"
    else
        extract_dir="${tmp}/extract"
        if ! mkdir -p "$extract_dir"; then
            optional_warn "zotero install failed — could not create temp extract dir"
        elif ! curl -fL -o "${tmp}/zotero.tar.xz" "$ZOTERO_URL"; then
            optional_warn "zotero download failed — retry: curl -fL -O ${ZOTERO_URL}"
        elif ! tar -xJf "${tmp}/zotero.tar.xz" -C "$extract_dir"; then
            optional_warn "zotero extraction failed — retry: curl -fL -O ${ZOTERO_URL}"
        elif [ ! -x "${extract_dir}/Zotero_linux-x86_64/zotero" ]; then
            optional_warn "zotero archive did not contain the expected executable"
        elif ! (
            set -e
            mkdir -p "$ZOTERO_OPT"
            rm -rf "${ZOTERO_OPT}/Zotero-${ZOTERO_VER}"
            # the tarball unpacks to a fixed Zotero_linux-x86_64/ name regardless of
            # version, so rename it rather than trusting --strip-components
            mv "${extract_dir}/Zotero_linux-x86_64" "${ZOTERO_OPT}/Zotero-${ZOTERO_VER}"
            ln -sfn "Zotero-${ZOTERO_VER}" "${ZOTERO_OPT}/Zotero"

            # PATH launcher, so `zotero` and the desktop entry survive upgrades
            mkdir -p "${HOME}/.local/bin"
            cat > "${HOME}/.local/bin/zotero" <<EOF
#!/bin/sh
# Zotero launcher — official tarball install at ~/.local/opt/Zotero (symlink to
# the current versioned dir). Kept so \`zotero\` resolves from PATH; the desktop
# entry calls this too.
exec "\$HOME/.local/opt/Zotero/zotero" "\$@"
EOF
            chmod 0755 "${HOME}/.local/bin/zotero"

            # desktop entry — the stock one uses a realpath hack and references a
            # zotero.ico the tarball doesn't ship, so rewrite both
            mkdir -p "${HOME}/.local/share/applications" "${HOME}/.local/share/icons/hicolor"
            sed 's|^Exec=.*|Exec=zotero %U|; s|^Icon=.*|Icon=zotero|' \
                "${ZOTERO_OPT}/Zotero/zotero.desktop" \
                > "${HOME}/.local/share/applications/zotero.desktop"
            for size in 128 64; do
                mkdir -p "${HOME}/.local/share/icons/hicolor/${size}x${size}/apps"
                cp "${ZOTERO_OPT}/Zotero/icons/icon${size}.png" \
                   "${HOME}/.local/share/icons/hicolor/${size}x${size}/apps/zotero.png"
            done
            mkdir -p "${HOME}/.local/share/icons/hicolor/scalable/apps"
            cp "${ZOTERO_OPT}/Zotero/icons/symbolic.svg" \
               "${HOME}/.local/share/icons/hicolor/scalable/apps/zotero-symbolic.svg"
            [ -x "${ZOTERO_OPT}/Zotero-${ZOTERO_VER}/zotero" ]
            [ -x "${HOME}/.local/bin/zotero" ]
            [ -f "${HOME}/.local/share/applications/zotero.desktop" ]
        ); then
            optional_warn "zotero install failed — retry: curl -fL -O ${ZOTERO_URL}"
            rm -rf "${ZOTERO_OPT}/Zotero-${ZOTERO_VER}"
            if [ "$(readlink "${ZOTERO_OPT}/Zotero" 2>/dev/null)" = "Zotero-${ZOTERO_VER}" ]; then
                rm -f "${ZOTERO_OPT}/Zotero"
            fi
        else
            success "zotero ${ZOTERO_VER} installed"
        fi
        rm -rf "$tmp"
    fi
else
    info "zotero already installed (v${ZOTERO_VER})"
fi

# the library dir is created but left empty — zotero.sqlite is written by the app
# itself on first run, and the data dir location is set inside zotero, not here
mkdir -p "$ZOTERO_LIB" || optional_warn "zotero library directory could not be created"

# ── drift ─────────────────────────────────────────────────────────
if ! command -v drift &>/dev/null; then
    info "installing drift (idle terminal screensaver)…"
    if ! GOBIN="$HOME/.local/bin" go install github.com/phlx0/drift@latest; then
        fail "drift install failed — retry with 'GOBIN=~/.local/bin go install github.com/phlx0/drift@latest'"
    fi
    command -v drift >/dev/null 2>&1 || fail "drift command missing after install"
else
    info "drift already installed ($(drift version 2>/dev/null | head -1))"
fi

# ── bleachbit ───────────────────────────────────────────────────────────────
if ! rpm -q bleachbit &>/dev/null; then
    info "installing bleachbit upstream rpm…"
    BB_VER="6.0.3"
    if ! tmp="$(mktemp -d)"; then
        optional_warn "bleachbit install failed — temp dir creation failed"
    else
        if curl -fL -o "$tmp/bleachbit.rpm" \
                "https://github.com/bleachbit/bleachbit/releases/download/v${BB_VER}/bleachbit-${BB_VER}-1.1.fc$(rpm -E %fedora).noarch.rpm" \
            && sudo dnf install -y "$tmp/bleachbit.rpm" \
            && rpm -q bleachbit &>/dev/null; then
            success "bleachbit installed"
        else
            optional_warn "bleachbit install failed — manual: https://www.bleachbit.org/download/linux"
        fi
        rm -rf "$tmp"
    fi
else
    info "bleachbit already installed ($(rpm -q bleachbit))"
fi

# ── rpm (direct) ────────────────────────────────────────────────────────────
info "installing rpm packages..."

# steam — ships from rpmfusion-nonfree-steam, not the (dead) valve repo
steam_ok=0
if ! rpm -q steam &>/dev/null; then
    if ! sudo dnf install -y \
        https://download1.rpmfusion.org/free/fedora/rpmfusion-free-release-$(rpm -E %fedora).noarch.rpm \
        https://download1.rpmfusion.org/nonfree/fedora/rpmfusion-nonfree-release-$(rpm -E %fedora).noarch.rpm; then
        optional_warn "rpmfusion release install failed"
    elif ! sudo dnf install -y \
        https://download1.rpmfusion.org/nonfree/fedora/rpmfusion-nonfree-steam-release-$(rpm -E %fedora).noarch.rpm; then
        optional_warn "rpmfusion steam repo install failed"
    elif ! sudo dnf install -y steam; then
        optional_warn "steam install failed"
    elif rpm -q steam &>/dev/null; then
        steam_ok=1
    else
        optional_warn "steam package missing after install"
    fi
else
    info "steam already installed ($(rpm -q steam))"
    steam_ok=1
fi

if [ "$steam_ok" -eq 1 ]; then
    success "steam installed"
fi

warn "veracrypt: download rpm from https://www.veracrypt.fr/en/Downloads.html and install manually"
warn "zed: install via 'curl -f https://zed.dev/install.sh | sh' or flatpak from flathub (dev.zed.Zed)"
warn "amule: flathub submission pending — install manually from https://amule-org.github.io/download (AppImage/.flatpak)"

info "rpm section done"

echo ""
if [ "$optional_failures" -eq 0 ]; then
    success "packages done. check warnings above for any manual steps needed."
else
    warn "packages done with ${optional_failures} optional install failure(s) — see warnings above."
fi
echo ""

{{- else if eq .machine "nixos" }}
# nixos packages are managed by home.nix and configuration.nix
# run: nix flake update && sudo nixos-rebuild switch --flake .
echo "nixos: packages managed by nix — skipping dnf/flatpak setup"
{{- end }}
