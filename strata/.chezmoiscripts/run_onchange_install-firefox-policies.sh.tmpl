#!/bin/sh
set -eu

# hash: {{ includeTemplate "firefox-policies.json" . | sha256sum }}

src="{{ .chezmoi.sourceDir }}/.chezmoitemplates/firefox-policies.json"
dst="/etc/firefox/policies/policies.json"

if [ ! -f "$src" ]; then
  echo "firefox policies source missing: $src" >&2
  exit 1
fi

if [ -f "$dst" ] && cmp -s "$src" "$dst"; then
  exit 0
fi

if ! sudo install -Dm644 "$src" "$dst"; then
  echo "Firefox policy install failed; run:" >&2
  echo "  sudo install -Dm644 '$src' '$dst'" >&2
  exit 1
fi
