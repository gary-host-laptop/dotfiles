#!/bin/bash

# =============================================================================
# XDG user dirs + desktop theming — runs once via chezmoi init
# =============================================================================

{{- if eq (.machine | default "fedora") "fedora" }}

info()    { echo "  [ .. ] $1"; }
success() { echo "  [ ok ] $1"; }

# xdg user dirs are managed files (~/.config/user-dirs.dirs and
# ~/.config/user-dirs.conf with enabled=False); nothing to do here.
info "xdg user dirs managed by chezmoi"

# cursor theme
info "setting cursor theme..."
gsettings set org.gnome.desktop.interface cursor-theme 'bibata-modern-classic'
gsettings set org.gnome.desktop.interface cursor-size 24
success "cursor theme set"

# system font
info "setting system font..."
gsettings set org.gnome.desktop.interface font-name 'Inter 11'
gsettings set org.gnome.desktop.interface document-font-name 'Inter 11'
gsettings set org.gnome.desktop.interface monospace-font-name 'FiraCode Nerd Font 11'
success "fonts set"

{{- else if eq .machine "nixos" }}
# nixos: xdg + theming managed by home.nix and configuration.nix
echo "nixos: xdg/theming managed by nix — skipping"
{{- end }}
