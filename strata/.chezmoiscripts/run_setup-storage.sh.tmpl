#!/bin/bash

# =============================================================================
# Storage topology — maps physical drives into strata
# Runs on every apply; links are idempotent and missing drives are skipped.
# =============================================================================

{{- if eq (.machine | default "fedora") "fedora" }}

STRATA="$HOME/strata"
VALUS_ROOT="${VALUS_ROOT:-/mnt/valus}"
PHAEDRA_ROOT="${PHAEDRA_ROOT:-/mnt/phaedra}"

info()    { echo "  [ .. ] $1"; }
success() { echo "  [ ok ] $1"; }
warn()    { echo "  [warn] $1"; }

link_storage() {
    local src="$1"
    local dst="$2"
    local parent

    if [ ! -d "$src" ]; then
        warn "source unavailable, leaving $dst alone: $src"
        return 0
    fi

    if [ -L "$dst" ]; then
        if [ "$(readlink "$dst")" = "$src" ]; then
            info "already linked: $dst"
            return 0
        fi
        warn "refusing to replace symlink: $dst -> $(readlink "$dst")"
        return 1
    fi

    if [ -e "$dst" ]; then
        warn "refusing to replace existing path: $dst"
        return 1
    fi

    parent="$(dirname "$dst")"
    mkdir -p "$parent" || {
        warn "failed to create parent directory: $parent"
        return 1
    }
    ln -s "$src" "$dst" || {
        warn "failed to create link: $dst -> $src"
        return 1
    }

    if [ "$(readlink "$dst")" != "$src" ]; then
        warn "link verification failed: $dst"
        return 1
    fi

    success "linked $dst → $src"
}

storage_failed=0

# valus
link_storage "$VALUS_ROOT/32_audio"             "$STRATA/30-39_media/32_audio" || storage_failed=1
link_storage "$VALUS_ROOT/35_video-games/games-library" "$STRATA/30-39_media/35_video-games/games-library" || storage_failed=1

# phaedra
link_storage "$PHAEDRA_ROOT/34_video"           "$STRATA/30-39_media/34_video" || storage_failed=1
link_storage "$PHAEDRA_ROOT/35_video-games/SteamLibrary" "$STRATA/30-39_media/35_video-games/steam" || storage_failed=1

# cursor themes
mkdir -p "$HOME/.local/share/icons" || storage_failed=1
link_storage "$HOME/strata/10-19_system/13_system-config/theming/cursor/bibata-modern-classic" "$HOME/.local/share/icons/bibata-modern-classic" || storage_failed=1
link_storage "$HOME/strata/10-19_system/13_system-config/theming/cursor/bibata-modern-ice" "$HOME/.local/share/icons/bibata-modern-ice" || storage_failed=1

if [ "$storage_failed" -ne 0 ]; then
    warn "storage setup incomplete — fix the conflicts above"
    exit 1
fi

{{- else if eq .machine "nixos" }}
# nixos: storage topology managed separately
# edit this section for nixos-specific mount points
echo "nixos: storage topology — edit run_setup-storage.sh for your nixos mounts"
{{- end }}
