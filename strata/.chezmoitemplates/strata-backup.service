[Unit]
Description=Strata Plakar essentials backup
After=local-fs.target

[Service]
Type=oneshot
User=ghost_user
Group=ghost_user
Environment=HOME=/home/ghost_user
ExecStart=/usr/local/bin/strata-backup
LoadCredential=plakar-passphrase:/etc/plakar/passphrase
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=1h
