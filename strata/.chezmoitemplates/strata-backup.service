[Unit]
Description=Strata Plakar essentials backup
After=local-fs.target

[Service]
Type=oneshot
User={{ .chezmoi.username }}
Environment="HOME={{ .chezmoi.homeDir }}"
ExecStart=/usr/local/bin/strata-backup
LoadCredential=plakar-passphrase:/etc/plakar/passphrase
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=1h
