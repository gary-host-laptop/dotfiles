# nushell environment (mirrors bash/exports.bash env vars; PATH is inherited from
# the session tree — environment.d/90-user.conf and GDM-sourced ~/.profile)
# keeps interactive env identical across shells; scripts stay shell-agnostic.

# PATH: normalize-only safety net — inherits from the manager env
# (environment.d/90-user.conf is the GUI/session baseline: gnome-shell
# -> ghostty -> zellij -> nu) or from ~/.profile (bash login/tty tree) and just
# collapses duplicates. NEVER adds entries here. On Nushell 0.99.1, env.nu runs
# before the PATH string-to-list conversion, so the value is normally an
# inherited string. Split it for list ops, then join back to a string; after
# startup, Nushell converts PATH to a list for the REPL. The string/list branch
# also keeps this safe if PATH is already a list; `uniq` is a global distinct,
# first-occurrence-preserving dedupe.
$env.PATH = (
    (if ($env.PATH | describe | str starts-with "string") {
        $env.PATH | split row ":"
      } else {
        $env.PATH
      })
    | where {|e| $e != ""}
    | uniq
    | str join ":"
)

$env.CARGO_INSTALL_OPTS = "--jobs 1"

$env.EZA_ICONS_AUTO = "1"

# eza colors — single source of truth: dot_bash/eza-colors
$env.EZA_COLORS = (open "{{ .chezmoi.sourceDir }}/dot_bash/eza-colors" | str trim)

# starship — point at the repo's shared prompt config (init happens in config.nu)
$env.STARSHIP_CONFIG = "{{ .chezmoi.sourceDir }}/dot_config/starship.toml"