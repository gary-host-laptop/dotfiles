# retroarch.cfg — trimmed to non-default keys (vlc-style precedent)
# full file is generated by RetroArch on first run; this tracks only what matters
# paths use a with/index fallback so a fresh clone degrades to the fedora library path

# dirs — user-owned, never under /usr/lib64 (Fedora ships no system cores dir)
libretro_directory = "{{ .chezmoi.homeDir }}/.config/retroarch/cores"
system_directory = "{{ with index . "retroarch" }}{{ with index . "libraryRoot" }}{{ . }}{{ else }}/mnt/valus/35_video-games/games-library{{ end }}{{ else }}/mnt/valus/35_video-games/games-library{{ end }}/bios"
savefile_directory = "{{ .chezmoi.homeDir }}/.config/retroarch/saves"
savestate_directory = "{{ .chezmoi.homeDir }}/.config/retroarch/states"
screenshot_directory = "{{ .chezmoi.homeDir }}/.config/retroarch/screenshots"
cache_directory = "{{ .chezmoi.homeDir }}/.config/retroarch/cache"
playlist_directory = "{{ .chezmoi.homeDir }}/.config/retroarch/playlists"

# system data from the dnf packages (retroarch, retroarch-assets)
assets_directory = "/usr/share/libretro/assets"
libretro_info_path = "/usr/share/libretro/info"
joypad_autoconfig_dir = "/usr/share/libretro/autoconfig"
content_database_path = "/usr/share/libretro/database/rdb"

# drivers — glcore for the Vega APU, pipewire audio
video_driver = "glcore"
audio_driver = "pipewire"
menu_driver = "ozone"

# input
input_autodetect_enable = "true"
input_joypad_driver = "sdl2"