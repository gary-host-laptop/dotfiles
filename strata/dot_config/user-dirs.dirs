# Managed by chezmoi. Do not edit this file directly; edit
# strata/dot_config/user-dirs.dirs in the dotfiles source.
# ~/.config/user-dirs.conf sets enabled=False, so xdg-user-dirs-update
# will not rewrite these paths when a drive is unmounted.
# Format is XDG_xxx_DIR="$HOME/yyy", where yyy is a shell-escaped
# homedir-relative path, or XDG_xxx_DIR="/yyy", where /yyy is an
# absolute path. No other format is supported.
#
XDG_DESKTOP_DIR="$HOME/Desktop"
XDG_DOWNLOAD_DIR="$HOME/strata/10-19_system/16_inbox"
XDG_TEMPLATES_DIR="$HOME/strata/10-19_system/13_system-config/templates"
XDG_PUBLICSHARE_DIR="$HOME/Public"
XDG_DOCUMENTS_DIR="$HOME/strata/30-39_media/31_text"
XDG_MUSIC_DIR="$HOME/strata/30-39_media/32_audio"
XDG_PICTURES_DIR="$HOME/strata/30-39_media/33_images"
XDG_VIDEOS_DIR="$HOME/strata/30-39_media/34_video"
