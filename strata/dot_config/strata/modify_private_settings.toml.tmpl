#!/usr/bin/env python3

import re
import sys

HOME = "{{ .chezmoi.homeDir }}"

SIDEBAR_ORDER = """[
    "home",
    "trash",
    "network",
    "recent",
    "desktop",
    "documents",
    "downloads",
    "music",
    "pictures",
    "videos",
]"""

DESIRED = {
    "mode": '"theme"',
    "theme": '"tokyo-night"',
    "omarchy_variant": '"original"',
    "file_icon_colors": '"brand"',
    "element_glow": "true",
    "corner_roundness": "80",
    "text_size": "12",
    "interface_font": '"Inter"',
    "interface_renderer": '"system"',
    "language": '"auto"',
    "browser_mode": '"icons"',
    "browser_density": '"airy"',
    "browser_density_custom_px": "7",
    "frame_density": '"custom"',
    "frame_density_custom_px": "3",
    "single_click_previews": "true",
    "render_documents_by_default": "true",
    "video_preview_backend": '"automatic"',
    "preview_muted": "true",
    "preview_volume": "1.0",
    "preview_text_wrap": "true",
    "preview_autoplay": "false",
    "show_thumbnails": "true",
    "icons_thumbnail_size": "64",
    "thumbnail_workers": "4",
    "sidebar_order": SIDEBAR_ORDER,
    "sidebar_show_home": "true",
    "sidebar_show_trash": "true",
    "sidebar_show_network": "false",
    "sidebar_show_recent": "true",
    "sidebar_show_desktop": "false",
    "sidebar_show_documents": "true",
    "sidebar_show_downloads": "true",
    "sidebar_show_music": "true",
    "sidebar_show_pictures": "true",
    "sidebar_show_videos": "false",
    "sidebar_expanded": "true",
    "sidebar_compact": "false",
    "window_show_close": "true",
    "window_show_minimize": "false",
    "window_show_maximize": "false",
    "reduce_motion": "false",
    "show_keybinding_hints": "true",
    "default_directory": f'"{HOME}/strata"',
}

KEY_RE = re.compile(r"^([A-Za-z0-9_]+)\s*=")


def sidebar_lines():
    lines = DESIRED["sidebar_order"].splitlines()
    return [f"sidebar_order = {lines[0]}", *lines[1:]]


def main():
    lines = sys.stdin.read().splitlines()
    out = []
    seen = set()
    i = 0

    while i < len(lines):
        line = lines[i]
        match = KEY_RE.match(line)
        if not match:
            out.append(line)
            i += 1
            continue

        key = match.group(1)
        if key == "sidebar_order":
            j = i
            depth = 0
            started = False
            while j < len(lines):
                depth += lines[j].count("[") - lines[j].count("]")
                if "[" in lines[j]:
                    started = True
                if started and depth <= 0:
                    break
                j += 1
            out.extend(sidebar_lines())
            seen.add(key)
            i = j + 1
            continue

        if key in DESIRED:
            out.append(f"{key} = {DESIRED[key]}")
            seen.add(key)
        else:
            out.append(line)
        i += 1

    missing = [key for key in DESIRED if key not in seen]
    if missing:
        if out and out[-1].strip():
            out.append("")
        for key in missing:
            if key == "sidebar_order":
                out.extend(sidebar_lines())
            else:
                out.append(f"{key} = {DESIRED[key]}")

    sys.stdout.write("\n".join(out) + "\n")


if __name__ == "__main__":
    main()
