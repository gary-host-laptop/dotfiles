# source global definitions
if [ -f /etc/bashrc ]; then
    . /etc/bashrc
fi

# ~/.bashrc.d user drop-ins
if [ -d "$HOME/.bashrc.d" ]; then
    for rc in "$HOME"/.bashrc.d/*; do
        [ -f "$rc" ] && . "$rc"
    done
    unset rc
fi

# guard for non-login interactive shells (most terminal emulators spawn bash
# non-login, so ~/.profile never ran): ensure the single PATH assembly happened
# exactly once, without duplicating it here. ~/.profile is the bash tree's writer
# (environment.d roots the session/GUI tree at boot).
if [ -z "$_DOTFILES_PROFILE_SOURCED" ] && [ -f "$HOME/.profile" ]; then
    . "$HOME/.profile"
fi

# core interactive tools (PATH is fully assembled by this point either way)
eval "$(starship init bash 2>/dev/null)"
eval "$(zoxide init bash 2>/dev/null)"

# source dotfiles bash configs
DOTFILES="{{ .chezmoi.sourceDir }}"
. "$DOTFILES/dot_bash/exports.bash"
. "$DOTFILES/dot_bash/aliases.bash"
. "$DOTFILES/dot_bash/drift.bash"
unset DOTFILES