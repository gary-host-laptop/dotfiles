# source global definitions
if [ -f /etc/bashrc ]; then
    . /etc/bashrc
fi

# ~/.bashrc.d user drop-ins
if [ -d "$HOME/.bashrc.d" ]; then
    for rc in "$HOME"/.bashrc.d/*; do
        [ -f "$rc" ] && . "$rc"
    done
    unset rc
fi

# opencode — add once, never stack (no-op if not installed)
case ":$PATH:" in *":$HOME/.opencode/bin:"*) ;; *) PATH="$HOME/.opencode/bin:$PATH" ;; esac

# cargo — on PATH before tooling inits so cargo-installed tools (zoxide,
# topgrade) resolve even in the first post-login shell (.profile runs after .bashrc)
case ":$PATH:" in *":$HOME/.cargo/bin:"*) ;; *) PATH="$HOME/.cargo/bin:$PATH" ;; esac

# core interactive tools
eval "$(starship init bash 2>/dev/null)"
eval "$(zoxide init bash 2>/dev/null)"

{{- if eq (.machine | default "fedora") "fedora" }}
# pkg-config (fedora multilib layout)
export PKG_CONFIG_PATH=/usr/lib64/pkgconfig

# go (installed at /usr/local/go) — append only if not present
case ":$PATH:" in *":/usr/local/go/bin:"*) ;; *) PATH="$PATH:/usr/local/go/bin" ;; esac
{{- end }}

# pin ~/.local/bin to the front and drop duplicate entries, so any polluted
# ancestor converges clean in one hop. Idempotent, POSIX-only.
if [ -n "$PATH" ]; then
    pinned=""
    IFS_OLD=$IFS
    IFS=:
    for _d in $PATH; do
        [ -z "$_d" ] && continue
        case ":$pinned:" in *":$_d:"*) continue ;; esac
        [ "$_d" = "$HOME/.local/bin" ] && continue
        pinned="${pinned}${pinned:+:}${_d}"
    done
    IFS=$IFS_OLD
    unset _d
    export PATH="$HOME/.local/bin:$pinned"
fi

# source dotfiles bash configs
DOTFILES="{{ .chezmoi.sourceDir }}"
. "$DOTFILES/dot_bash/exports.bash"
. "$DOTFILES/dot_bash/aliases.bash"
. "$DOTFILES/dot_bash/drift.bash"
unset DOTFILES