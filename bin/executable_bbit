#!/bin/bash
# interactive cleanup — asks before cleaning the default safe set via BleachBit
# dnf.clean_all       → sudo dnf clean all (needs root)
# thumbnails.cache    → clear thumbnail cache
# journald.clean      → journal maintenance

CLEANERS="dnf.clean_all thumbnails.cache journald.clean"

echo -e "\nbleachbit: about to run (as root): ${CLEANERS}\n"
read -r -p "continue? [y/N] " answer
[[ "$answer" =~ ^[Yy]$ ]] || { echo "aborted"; exit 0; }

sudo bleachbit -c $CLEANERS
